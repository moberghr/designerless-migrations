root = true

# The repository is LF throughout (see .gitattributes). Without this, dotnet format falls back to the platform
# default, CRLF on Windows, and reports every line as a whitespace error.
[*]
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,xml,json,yml,yaml}]
indent_size = 2

# Tests only. Approved for test projects; the packages stay strict.
[tests/**.cs]
# CA1707: Identifiers should not contain underscores (test method naming convention uses underscores)
dotnet_diagnostic.CA1707.severity = none
