<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A consumer's test project. It references the design package plainly (not the way 'dotnet add package' writes a
    development dependency, which excludes compile assets), so it can call MigrationConventions.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moberg.EntityFrameworkCore.DesignerlessMigrations" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NpgsqlSample\NpgsqlSample.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
